# RagBench Railway Environment Variables
# Set these in Railway dashboard: Project → Variables

# === LLM API Keys (at least one required) ===
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# === Vector Store ===
# Option A: Qdrant Cloud (recommended for Railway)
# Get free tier at: https://cloud.qdrant.io
QDRANT_URL=https://YOUR-CLUSTER.qdrant.io
QDRANT_API_KEY=

# Option B: Railway-hosted Qdrant (add qdrant service in Railway)
# QDRANT_URL=http://qdrant.railway.internal:6333

# === Auto-set by Railway (do not set manually) ===
# DATABASE_URL — auto-injected from Railway Postgres plugin
# PORT — auto-set by Railway per service
# RAILWAY_PUBLIC_DOMAIN — auto-set
